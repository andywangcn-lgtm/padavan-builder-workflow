CONFIG_VENDOR=Ralink  
CONFIG_FIRMWARE_PRODUCT_ID="NEWIFI-MINI"

CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_FAT=y
CONFIG_FIRMWARE_ENABLE_EXFAT=y
CONFIG_FIRMWARE_ENABLE_NTFS=n
CONFIG_FIRMWARE_ENABLE_EXT2=y
CONFIG_FIRMWARE_ENABLE_EXT3=y
CONFIG_FIRMWARE_ENABLE_EXT4=y

# 关闭占用极大的 Samba (局域网共享) 和 DLNA
CONFIG_FIRMWARE_ENABLE_samba=n
CONFIG_FIRMWARE_ENABLE_samba36=n
CONFIG_FIRMWARE_ENABLE_dlna=n

# 关闭下载工具
CONFIG_FIRMWARE_ENABLE_aria2=n
CONFIG_FIRMWARE_ENABLE_transmission=n

# 关闭高级网络/VPN 插件（仅保留做中继和基础上网所需的组件）
CONFIG_FIRMWARE_ENABLE_openvpn=n
CONFIG_FIRMWARE_ENABLE_wireguard=n
CONFIG_FIRMWARE_ENABLE_ipset=n
CONFIG_FIRMWARE_ENABLE_smartdns=n
